# Open Shadow AI: one organization per deployment. Secrets come from mounted files.
tenant_id: default
server:
  host: 0.0.0.0
  port: 8443
  debug: false
  log_level: INFO
  cors_origins: []
database:
  clickhouse_host: clickhouse
  clickhouse_port: 9000
  clickhouse_database: shadai
  # External ClickHouse over native TLS (verification is always enforced):
  # clickhouse_port: 9440
  # clickhouse_secure: true
  # clickhouse_ca_certs: /run/secrets/clickhouse-ca.pem
security:
  # Disable only after enrolling and verifying all HTTP collectors.
  allow_legacy_agent_key: true
  # Affects new server processing; history/local spools require separate maintenance.
  pseudonymize_identities: false
  # Optional independent monitoring credential: prefer METRICS_API_KEY_FILE; omit when unused.
  # metrics_api_key: null
retention:
  events_days: 90
  # Must be <= events_days; counts are observed identifiers, not employee headcount.
  identity_days: 30
  detections_days: 365
  audit_logs_days: 365
  purge_enabled: true
  ingestion_max_age_days: 90
  receipt_days: 181
catalog:
  builtin_path: /app/catalog/builtin
  local_path: /app/catalog/local
  reload_interval_seconds: 60
privacy:
  strip_query_params: true
  no_url_path_retention: true
  # Match URL paths and user agents in memory at ingestion; only the catalog match is kept.
  match_transient_signals: true
