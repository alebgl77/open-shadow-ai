# The syslog profile exposes this BIND listener on loopback by default.
# Configure one parser per listener; see docs/collectors.md.
sources:
  - name: dns-pilot
    type: syslog
    enabled: true
    config:
      listen_port: 1514
      protocol: tcp
      parser: bind_query_log
      # IANA zone for device-local timestamps without an offset, e.g. Europe/Paris.
      # FortiGate eventtime/tz fields take precedence when present.
      timezone: UTC
# Entra runs separately; declaring an API source here does not poll it.
