# No credentials belong here. Run scripts/bootstrap.ps1 or bootstrap.sh.
SHADAI_BIND_ADDRESS=127.0.0.1
SHADAI_API_PORT=8443
SHADAI_UI_PORT=3000
SHADAI_SYSLOG_PORT=1514
SHADAI_TENANT_ID=default
CORS_ORIGINS=[]
# Console session cookie: auto = Secure everywhere except localhost; true/false force it.
SESSION_COOKIE_SECURE=auto
# Server settings live in config/shadai.yaml. To use environment overrides, add them
# to the API/worker environments in a private Compose override (not inferred from .env):
# ALLOW_LEGACY_AGENT_KEY=false  # after scoped enrollment and verification
# PSEUDONYMIZE_IDENTITIES=true # new processing only; history/spools need maintenance
# IDENTITY_RETENTION_DAYS=30   # positive and <= events_days; never pass an empty value
# Optional monitoring: provision METRICS_API_KEY_FILE in a private Compose override.
# Base bootstrap still creates only six secrets; see docs/collector-operations.md.
# Optional Entra collector (compose profile: entra).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_POLL_INTERVAL_SECONDS=300
ENTRA_COLLECT_GRANTS=false
