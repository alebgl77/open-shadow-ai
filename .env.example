# No credentials belong here. Run scripts/bootstrap.ps1 or bootstrap.sh.
SHADAI_BIND_ADDRESS=127.0.0.1
SHADAI_API_PORT=8443
SHADAI_UI_PORT=3000
SHADAI_SYSLOG_PORT=1514
SHADAI_TENANT_ID=default
CORS_ORIGINS=[]
# Console session cookie: auto = Secure everywhere except localhost; true/false force it.
SESSION_COOKIE_SECURE=auto
# Optional Entra collector (compose profile: entra).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_POLL_INTERVAL_SECONDS=300
ENTRA_COLLECT_GRANTS=false
