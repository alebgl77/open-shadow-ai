FROM python:3.12.15-slim-trixie@sha256:05cda9777409a9c3ffddd94a4c476b79f0769a0b4857f0c7ed9226b6800b0d6f
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 SHADAI_INTEGRATION=1
COPY pyproject.toml README.md alembic.ini ./
COPY src/ src/
COPY agent/ agent/
COPY requirements/ requirements/
RUN python -m pip install --no-cache-dir --only-binary=:all: --require-hashes -r requirements/build.txt \
    && python -m pip install --no-cache-dir --only-binary=:all: --require-hashes -r requirements/development.txt \
    && python -m pip install --no-cache-dir --no-deps --no-build-isolation . ./agent \
    && python -m pip check \
    && python -c "import pytest, shadai, shadai_agent.main" \
    && python -m pip uninstall --yes pip \
    && python -c "import shutil; shutil.rmtree('/usr/local/lib/python3.12/ensurepip')" \
    && python -c "import importlib.util, pathlib; assert importlib.util.find_spec('pip') is None; assert importlib.util.find_spec('ensurepip') is None; assert not pathlib.Path('/usr/local/lib/python3.12/ensurepip').exists(); assert not list(pathlib.Path('/usr/local/lib/python3.12').rglob('pip-*.whl')); assert not list(pathlib.Path('/usr/local/lib/python3.12/site-packages').glob('pip*')); assert not list(pathlib.Path('/usr/local/bin').glob('pip*')); import pytest, shadai, shadai_agent.main" \
    && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin shadai
COPY tests/ tests/
COPY scripts/ scripts/
COPY migrations/ migrations/
COPY catalog/ catalog/
COPY docker/clickhouse-init/ docker/clickhouse-init/
COPY docker/entrypoint.py /app/entrypoint.py
USER 10001:10001
ENTRYPOINT ["python", "/app/entrypoint.py"]
CMD ["python", "-m", "pytest", "-q", "-m", "integration", "-p", "no:cacheprovider"]
