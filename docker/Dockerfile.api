FROM python:3.12-slim AS builder
WORKDIR /build
COPY pyproject.toml README.md ./
COPY src/ src/
RUN pip install --no-cache-dir --prefix=/install .

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN groupadd --gid 10001 shadai && useradd --uid 10001 --gid shadai --no-create-home --shell /usr/sbin/nologin shadai
COPY --from=builder /install /usr/local
COPY --chown=10001:10001 migrations/ migrations/
COPY --chown=10001:10001 alembic.ini ./
COPY --chown=10001:10001 catalog/ catalog/
COPY --chown=10001:10001 docker/entrypoint.py /app/entrypoint.py
USER 10001:10001
EXPOSE 8443
ENTRYPOINT ["python", "/app/entrypoint.py"]
CMD ["uvicorn","shadai.main:app","--host","0.0.0.0","--port","8443","--no-access-log"]
