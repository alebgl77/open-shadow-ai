FROM python:3.12.15-slim-trixie@sha256:05cda9777409a9c3ffddd94a4c476b79f0769a0b4857f0c7ed9226b6800b0d6f AS builder
WORKDIR /build
COPY pyproject.toml README.md ./
COPY src/ src/
COPY requirements/ requirements/
RUN python -m pip install --no-cache-dir --only-binary=:all: --require-hashes -r requirements/build.txt \
    && python -m pip install --no-cache-dir --only-binary=:all: --require-hashes --prefix=/install -r requirements/runtime.txt \
    && python -m pip install --no-cache-dir --prefix=/install --no-deps --no-build-isolation .

FROM python:3.12.15-slim-trixie@sha256:05cda9777409a9c3ffddd94a4c476b79f0769a0b4857f0c7ed9226b6800b0d6f
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN groupadd --gid 10001 shadai && useradd --uid 10001 --gid shadai --no-create-home --shell /usr/sbin/nologin shadai
COPY --from=builder /install /usr/local
COPY --chown=10001:10001 migrations/ migrations/
COPY --chown=10001:10001 alembic.ini ./
COPY --chown=10001:10001 catalog/ catalog/
COPY --chown=10001:10001 docker/entrypoint.py /app/entrypoint.py
USER 10001:10001
EXPOSE 8443
ENTRYPOINT ["python", "/app/entrypoint.py"]
CMD ["uvicorn","shadai.main:app","--host","0.0.0.0","--port","8443","--proxy-headers","--no-access-log"]
