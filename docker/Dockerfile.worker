FROM python:3.12.15-slim-trixie@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1 AS builder
WORKDIR /build
COPY pyproject.toml README.md ./
COPY src/ src/
COPY requirements/ requirements/
RUN python -m pip install --no-cache-dir --only-binary=:all: --require-hashes -r requirements/build.txt \
    && python -m pip install --no-cache-dir --only-binary=:all: --require-hashes --prefix=/install -r requirements/runtime.txt \
    && python -m pip install --no-cache-dir --prefix=/install --no-deps --no-build-isolation .

FROM python:3.12.15-slim-trixie@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
# DSA-6549-1: the official image still ships liblzma5 5.8.1-1+deb13u1; install the exact fixed Debian package.
RUN apt-get update \
    && apt-get install -y --no-install-recommends liblzma5=5.8.1-1+deb13u2 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 10001 shadai && useradd --uid 10001 --gid shadai --no-create-home --shell /usr/sbin/nologin shadai
COPY --from=builder /install /usr/local
COPY --chown=10001:10001 catalog/ catalog/
COPY --chown=10001:10001 docker/entrypoint.py /app/entrypoint.py
USER 10001:10001
ENTRYPOINT ["python", "/app/entrypoint.py"]
CMD ["python","-m","shadai.workers.ingest"]
