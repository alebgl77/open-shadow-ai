FROM python:3.12.15-slim-trixie@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704 AS builder
WORKDIR /build
COPY pyproject.toml README.md ./
COPY src/ src/
COPY requirements/ requirements/
RUN python -m pip install --no-cache-dir --only-binary=:all: --require-hashes -r requirements/build.txt \
    && python -m pip install --no-cache-dir --only-binary=:all: --require-hashes --prefix=/install -r requirements/runtime.txt \
    && python -m pip install --no-cache-dir --prefix=/install --no-deps --no-build-isolation .

FROM python:3.12.15-slim-trixie@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN --mount=type=bind,source=docker/install-debian-security.py,target=/tmp/install-debian-security.py,ro \
    python /tmp/install-debian-security.py
RUN groupadd --gid 10001 shadai && useradd --uid 10001 --gid shadai --no-create-home --shell /usr/sbin/nologin shadai
COPY --from=builder /install /usr/local
COPY --chown=10001:10001 catalog/ catalog/
COPY --chown=10001:10001 docker/entrypoint.py /app/entrypoint.py
USER 10001:10001
ENTRYPOINT ["python", "/app/entrypoint.py"]
CMD ["python","-m","shadai.workers.ingest"]
