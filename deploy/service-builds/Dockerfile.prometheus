# Maintained recipe 3: pinned release source, toolchain and readonly module graph.
FROM golang:1.26.9-alpine3.24@sha256:3082400e369fa24d5fc60bca20edab3f6d604e0c5a690ec66b295eff4dd87ade AS build
WORKDIR /src
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOENV=off GOWORK=off GOPROXY=https://proxy.golang.org GOSUMDB=sum.golang.org GOFLAGS=-mod=readonly GOTELEMETRY=off
RUN test "$(go version | cut -d ' ' -f 3)" = go1.26.9 \
    && go mod download -json github.com/prometheus/prometheus@v0.315.0 > /tmp/source.json \
    && grep -F '"Sum": "h1:sFGZWmC2Hk9N1NBJGCnXYZb5hyLCq8yuAMoEjLAg6ac=",' /tmp/source.json \
    && grep -F '"Hash": "5241a27fe3c6983549fccc32f6e65917408c63cd",' /tmp/source.json \
    && grep -F '"Zip": "/go/pkg/mod/cache/download/github.com/prometheus/prometheus/@v/v0.315.0.zip",' /tmp/source.json \
    && echo '24864cfffc07315d94f9385f35a03046a1c1a345c96e731425a3b5b7ce2ba9b9  /go/pkg/mod/cache/download/github.com/prometheus/prometheus/@v/v0.315.0.zip' | sha256sum -c - \
    && unzip -q /go/pkg/mod/cache/download/github.com/prometheus/prometheus/@v/v0.315.0.zip -d /tmp/source \
    && tar -C /tmp/source/github.com/prometheus/prometheus@v0.315.0 -cf - . | tar -C /src -xf - \
    && rm -r /tmp/source /tmp/source.json \
    && wget -O /tmp/web-ui.tar.gz https://github.com/prometheus/prometheus/releases/download/v3.15.0/prometheus-web-ui-3.15.0.tar.gz \
    && echo 'fa8c918ed05e3f89e232e9b69eccd6ed074602cd9e8a2cab7a92bec9651974ae  /tmp/web-ui.tar.gz' | sha256sum -c - \
    && tar -xzf /tmp/web-ui.tar.gz -C /src/web/ui \
    && rm /tmp/web-ui.tar.gz \
    && cd /src/web/ui \
    && cp embed.go.tmpl embed.go \
    && find static -type f ! -name '*.gz' -exec sh -c 'for f do gzip -c "$f" > "$f.gz" || exit 1; done' sh {} + \
    && find static -type f -name '*.gz' -print0 | sort -z | xargs -0 echo //go:embed >> embed.go \
    && echo var EmbedFS embed.FS >> embed.go
COPY requirements/service-builds/prometheus/go.mod requirements/service-builds/prometheus/go.sum ./
COPY requirements/service-builds/prometheus/modules.txt /locked-modules.txt
RUN printf '%s\n' 'd85af091d5bf9ba19f98e4d92e24b368d3e5537af086521ef10c7dd669695fd7  go.mod' 'd788de08ccf06166baafa21b52764bd0af13328903a447029ee08b21fbd4ae67  go.sum' '48a253a48d28565de9eca04945bf970449c5ab315b955044fda8e53995047cdb  /locked-modules.txt' | sha256sum -c - \
    && go mod download \
    && go mod verify \
    && go list -m all | cmp - /locked-modules.txt \
    && mkdir /out \
    && go build -trimpath -buildvcs=false -tags netgo,builtinassets -ldflags='-s -w -X github.com/prometheus/common/version.Version=3.15.0-shadai.3 -X github.com/prometheus/common/version.Revision=5241a27fe3c6983549fccc32f6e65917408c63cd -X github.com/prometheus/common/version.Branch=maintained -X github.com/prometheus/common/version.BuildUser=shadai -X github.com/prometheus/common/version.BuildDate=2026-10-12T00:00:00Z' -o /out/prometheus ./cmd/prometheus \
    && go build -trimpath -buildvcs=false -tags netgo,builtinassets -ldflags='-s -w -X github.com/prometheus/common/version.Version=3.15.0-shadai.3 -X github.com/prometheus/common/version.Revision=5241a27fe3c6983549fccc32f6e65917408c63cd -X github.com/prometheus/common/version.Branch=maintained -X github.com/prometheus/common/version.BuildUser=shadai -X github.com/prometheus/common/version.BuildDate=2026-10-12T00:00:00Z' -o /out/promtool ./cmd/promtool \
    && cp /locked-modules.txt /out/GO-MODULES.txt \
    && find /go/pkg/mod -type f \( -iname 'license*' -o -iname 'notice*' -o -iname 'copying*' -o -iname 'copyright*' \) \
       -exec sh -c 'for p do printf "\nSOURCE LICENSE %s\n" "$p"; cat "$p"; done' sh {} + > /out/THIRD-PARTY-NOTICES.txt
FROM prom/prometheus:v3.15.0@sha256:efd719c99d83b060d9daefdcf00360461adf279f45ef5391f8d111892118753e
COPY --from=build /out/prometheus /out/promtool /bin/
COPY --from=build /src/LICENSE /src/NOTICE /usr/local/share/licenses/shadai/prometheus/
COPY --from=build /usr/local/go/LICENSE /usr/local/share/licenses/shadai/prometheus/GO-LICENSE
COPY --from=build /out/GO-MODULES.txt /out/THIRD-PARTY-NOTICES.txt /usr/local/share/licenses/shadai/prometheus/
LABEL io.shadai.maintenance.recipe="3" \
      io.shadai.maintenance.component="prometheus" \
      io.shadai.maintenance.version="v3.15.0-shadai.3" \
      io.shadai.maintenance.source="5241a27fe3c6983549fccc32f6e65917408c63cd" \
      io.shadai.maintenance.toolchain="go1.26.9"
RUN /bin/prometheus --version && /bin/promtool --version
